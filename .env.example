# ================================
# Gambler API - Variables d'environnement
# ================================
# Copier ce fichier en .env et remplir les valeurs

# Cle secrete partagee avec l'application principale
# Generer avec : python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change-me-to-a-long-random-secret

# Port d'ecoute du service
PORT=9000

# Fournisseur LLM pour l'extraction du PDF
# Options : anthropic | groq | mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
