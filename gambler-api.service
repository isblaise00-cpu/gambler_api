[Unit]
Description=Gambler API - Service de generation de pronostics hippiques
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/gambler-api
EnvironmentFile=/var/www/gambler-api/.env
ExecStart=/var/www/gambler-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 9000 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
